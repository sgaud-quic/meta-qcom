From afeb61af93cfeaf126ece031d6fffb55275a8e39 Mon Sep 17 00:00:00 2001
From: Ricardo Salveti <ricardo.salveti@oss.qualcomm.com>
Date: Sat, 26 Sep 2026 03:27:47 +0000
Subject: [meta-audioreach][PATCH] layer.conf: add blacksail to
 LAYERSERIES_COMPAT

OE-core master has switched to the blacksail release series and dropped
wrynose from LAYERSERIES_CORENAMES, so the layer no longer parses.
Declare blacksail compatibility alongside the existing series.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Ricardo Salveti <ricardo.salveti@oss.qualcomm.com>
Upstream-Status: Submitted [https://github.com/AudioReach/meta-audioreach/pull/196]
---
 conf/layer.conf | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/conf/layer.conf b/conf/layer.conf
index 68841e5..e586ac1 100644
--- a/conf/layer.conf
+++ b/conf/layer.conf
@@ -5,4 +5,4 @@ BBFILE_PRIORITY_meta-audioreach = "6"
 BBFILE_PATTERN_meta-audioreach := "^${LAYERDIR}/"
 
 LAYERDEPENDS_meta-audioreach = "multimedia-layer"
-LAYERSERIES_COMPAT_meta-audioreach = "wrynose"
+LAYERSERIES_COMPAT_meta-audioreach = "wrynose blacksail"
-- 
